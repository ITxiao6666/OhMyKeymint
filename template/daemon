#!/system/bin/sh

MODDIR=${0%/*}
STATE_DIR=/data/adb/omk
RESTART_FILE=$STATE_DIR/restart.keymint
PEER_RESTART_FILE=$STATE_DIR/restart.injector
RESTART_ALL_FILE=$STATE_DIR/restart.all

export LD_LIBRARY_PATH="/system/lib64:/apex/com.android.runtime/lib64:/apex/com.android.runtime/lib64/bionic:/vendor/lib64:$LD_LIBRARY_PATH"

find_module_keymint() {
  if [ -f "/data/adb/omk/keymint" ]; then
    echo /data/adb/omk/keymint
    return 0
  fi
  if [ -f "$MODDIR/keymint" ]; then
    echo "$MODDIR/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/arm64-v8a/keymint" ]; then
    echo "$MODDIR/libs/arm64-v8a/keymint"
    return 0
  fi
  if [ -f "$MODDIR/libs/x86_64/keymint" ]; then
    echo "$MODDIR/libs/x86_64/keymint"
    return 0
  fi
  return 1
}

expand_shared_restart() {
  if [ -f "$RESTART_ALL_FILE" ]; then
    : > "$RESTART_FILE"
    : > "$PEER_RESTART_FILE"
    rm -f "$RESTART_ALL_FILE"
  fi
}

consume_restart_request() {
  expand_shared_restart

  if [ -f "$RESTART_FILE" ]; then
    rm -f "$RESTART_FILE"
    return 0
  fi

  return 1
}

cd "$MODDIR" || exit 1
mkdir -p "$STATE_DIR"

LOCK_DIR=$STATE_DIR/keymint-daemon.lock
PID_FILE=$STATE_DIR/keymint-daemon.pid

pid_matches_daemon() {
  [ -r "/proc/$1/cmdline" ] || return 1
  tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -F "$0" >/dev/null 2>&1
}

cleanup_daemon_lock() {
  rm -f "$PID_FILE"
  rmdir "$LOCK_DIR" 2>/dev/null
}

take_daemon_lock() {
  echo $$ > "$PID_FILE"
  trap cleanup_daemon_lock EXIT
  trap 'cleanup_daemon_lock; exit 0' INT TERM HUP
}

# A userspace restart (KernelSU soft reboot) re-runs the module scripts while the
# previous daemons keep running, so the daemon itself has to stay single-instance.
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
  owner=$(cat "$PID_FILE" 2>/dev/null)
  if [ -z "$owner" ]; then
    # Another instance may be between creating the lock and writing its pid.
    sleep 1
    owner=$(cat "$PID_FILE" 2>/dev/null)
  fi
  if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null && pid_matches_daemon "$owner"; then
    echo "[keymint-daemon] already running as pid $owner"
    exit 0
  fi
  rm -f "$PID_FILE"
  rmdir "$LOCK_DIR" 2>/dev/null
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    echo "[keymint-daemon] another daemon holds the lock; exiting"
    exit 0
  fi
fi
take_daemon_lock

while true; do
  TARGET=$(find_module_keymint)
  if [ -z "$TARGET" ]; then
    echo "[keymint-daemon] keymint binary not found"
    sleep 5
    continue
  fi

  chmod 0755 "$TARGET"

  "$TARGET" "$@" &
  child_pid=$!

  while kill -0 "$child_pid" 2>/dev/null; do
    if consume_restart_request; then
      echo "[keymint-daemon] restart requested"
      kill -TERM "$child_pid" 2>/dev/null
      sleep 2
      if kill -0 "$child_pid" 2>/dev/null; then
        kill -KILL "$child_pid" 2>/dev/null
      fi
      break
    fi
    sleep 2
  done

  wait "$child_pid"
  rc=$?
  echo "[keymint-daemon] keymint exited with code $rc"
  sleep 2
done
