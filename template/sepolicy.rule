allow keystore system_file unix_dgram_socket { getattr read recvfrom }
allow system_file keystore unix_dgram_socket sendto
allow keystore system_file file { execute getattr map read receive }

# Native SoterServer payload and its root-created inherited channels.
allow { platform_app system_app } system_file unix_dgram_socket { getattr read recvfrom }
allow system_file { platform_app system_app } unix_dgram_socket sendto
allow { platform_app system_app } system_file unix_stream_socket { getattr read write getopt setopt shutdown }
allow { platform_app system_app } system_file file { execute getattr map read receive }

# Permit only the verified EngineerMode application domain to expose argv[0]
# for exact UID-1000 caller binding. Core system domains remain blocked.
allow keystore engineermode_app dir search
allow keystore engineermode_app file { getattr open read }
# The exact EngineerMode process keeps its inherited Zygisk companion channel.
allow engineermode_app zygote unix_stream_socket { getattr read write getopt setopt shutdown }

# EngineerMode INCLUDE_UNIQUE_ID attestation (Attestation Key ID Modify).
# Ommega 9583e028: keep the standard permission gate, grant only this domain.
allow engineermode_app keystore keystore2_key gen_unique_id

allow crash_dump keystore process *

allow keystore default_android_service service_manager find
allow shell default_android_service service_manager find
